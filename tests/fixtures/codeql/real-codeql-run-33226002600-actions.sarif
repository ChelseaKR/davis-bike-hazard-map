                "properties": {
                  "tags": [
                    "actions",
                    "security",
                    "external/cwe/cwe-829"
                  ],
                  "description": "Checking out and running the build script from a fork executes untrusted code. Even in a\n              non-privileged workflow, this can be abused, for example to compromise self-hosted runners\n              or to poison caches and artifacts that are later consumed by privileged workflows.",
                  "id": "actions/untrusted-checkout/medium",
                  "kind": "problem",
                  "name": "Checkout of untrusted code in a non-privileged context",
                  "precision": "medium",
                  "problem.severity": "warning",
                  "security-severity": "5.0"
                }
              }
            ]

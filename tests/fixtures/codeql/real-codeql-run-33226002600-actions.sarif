                  ],
                  "description": "The cache can be poisoned by untrusted code, leading to a cache poisoning attack.",
                  "id": "actions/cache-poisoning/poisonable-step",
                  "kind": "path-problem",
                  "name": "Cache Poisoning via execution of untrusted code",
                  "precision": "high",

# DOC-22 (American English) exceptions. The conformance check never scans this
# file; each entry names the DOCUMENTATION-STANDARD exception it falls under.
[codespell]
# (a) GitHub's own spelling, quoted in workflow files: the `cancelled()` status
# function and the `cancelled` run conclusion. The prose around them is
# American English.
ignore-regex = !?cancelled\(\)|`cancelled`
# (c) package-lock.json is generated by npm from package.json; its British
# words are third-party package names (@img/colour,
# @babel/helper-optimise-call-expression).
skip = package-lock.json
